{
    "i18n": true,
    "type": "panel",
    "items": {
        "displaysHint": {
            "type": "staticText",
            "text": "displaysHint",
            "newLine": true,
            "xs": 12,
            "sm": 12,
            "md": 12,
            "lg": 12,
            "xl": 12
        },
        "devices": {
            "type": "table",
            "label": "Displays",
            "newLine": true,
            "xs": 12,
            "sm": 12,
            "md": 12,
            "lg": 12,
            "xl": 12,
            "clone": true,
            "export": true,
            "import": true,
            "items": [
                {
                    "type": "checkbox",
                    "attr": "enabled",
                    "title": "Active",
                    "width": "6%",
                    "default": true
                },
                {
                    "type": "text",
                    "attr": "name",
                    "title": "Name",
                    "width": "16%",
                    "default": "",
                    "sort": true
                },
                {
                    "type": "select",
                    "attr": "model",
                    "title": "Model",
                    "width": "14%",
                    "default": "laserNova",
                    "options": [
                        {
                            "value": "laserNova",
                            "label": "CTOUCH Laser Nova"
                        },
                        {
                            "value": "laserSky",
                            "label": "CTOUCH Laser Sky"
                        },
                        {
                            "value": "rivaR2",
                            "label": "CTOUCH Riva R2"
                        },
                        {
                            "value": "neo",
                            "label": "CTOUCH Neo"
                        },
                        {
                            "value": "cactus",
                            "label": "i3-CONNECT Cactus"
                        },
                        {
                            "value": "veneer2",
                            "label": "i3-CONNECT Veneer 2"
                        }
                    ]
                },
                {
                    "type": "select",
                    "attr": "connection",
                    "title": "Connection",
                    "width": "14%",
                    "default": "converter",
                    "options": [
                        {
                            "value": "converter",
                            "label": "Serial converter"
                        },
                        {
                            "value": "network",
                            "label": "Display network port"
                        }
                    ]
                },
                {
                    "type": "text",
                    "attr": "host",
                    "title": "IP address or host name",
                    "width": "16%",
                    "default": ""
                },
                {
                    "type": "number",
                    "attr": "port",
                    "title": "Port",
                    "width": "8%",
                    "min": 0,
                    "max": 65535,
                    "default": 0
                },
                {
                    "type": "number",
                    "attr": "displayId",
                    "title": "Set ID",
                    "width": "7%",
                    "min": 1,
                    "max": 255,
                    "default": 1
                },
                {
                    "type": "text",
                    "attr": "mac",
                    "title": "MAC address",
                    "width": "19%",
                    "default": "",
                    "validator": "!data.mac || /^([0-9a-fA-F]{2}[:-]?){5}[0-9a-fA-F]{2}$/.test(data.mac.trim())",
                    "validatorNoSaveOnError": true
                }
            ]
        },
        "pollInterval": {
            "type": "number",
            "label": "Poll interval (s)",
            "help": "pollHelp",
            "min": 5,
            "max": 3600,
            "newLine": true,
            "xs": 12,
            "sm": 12,
            "md": 4,
            "lg": 3,
            "xl": 3
        },
        "keysHeader": {
            "type": "header",
            "text": "Remote keys",
            "size": 4,
            "newLine": true,
            "xs": 12,
            "sm": 12,
            "md": 12,
            "lg": 12,
            "xl": 12
        },
        "keysHint": {
            "type": "staticText",
            "text": "keysHint",
            "newLine": true,
            "xs": 12,
            "sm": 12,
            "md": 12,
            "lg": 12,
            "xl": 12
        },
        "keysAnnexB": {
            "type": "staticText",
            "text": "Laser Nova, Laser Sky, Riva R2: power, input, up, down, left, right, enter, menu, home, exit, volumeUp, volumeDown, mute, backlight, freeze, screenshot",
            "noTranslation": true,
            "newLine": true,
            "xs": 12,
            "sm": 12,
            "md": 12,
            "lg": 12,
            "xl": 12
        },
        "keysNeo": {
            "type": "staticText",
            "text": "Neo: power, input, enter, menu, home, exit, mute, volumeUp, volumeDown, screenshot, annotation",
            "noTranslation": true,
            "newLine": true,
            "xs": 12,
            "sm": 12,
            "md": 12,
            "lg": 12,
            "xl": 12
        },
        "keysCactus": {
            "type": "staticText",
            "text": "Cactus: volumeUp, volumeDown, up, down, left, right, enter, menu, input, exit, mute, home",
            "noTranslation": true,
            "newLine": true,
            "xs": 12,
            "sm": 12,
            "md": 12,
            "lg": 12,
            "xl": 12
        },
        "keysVeneer2": {
            "type": "staticText",
            "text": "Veneer 2: volumeUp, volumeDown, up, down, left, right, enter, menu, input, exit, mute, home, blank, freeze",
            "noTranslation": true,
            "newLine": true,
            "xs": 12,
            "sm": 12,
            "md": 12,
            "lg": 12,
            "xl": 12
        }
    }
}
